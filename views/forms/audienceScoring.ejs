<form method="post" id="audience-scoring" class="form-horizontal" action="/admin/gameManagement/<%- game.code %>/scoring">
	<div class="row">
		<label class="col-sm-2 col-form-label">Point values</label>
		<div class="col-sm-10">
			<div class="row">
				<div class="col">
					<div class="row">
						<label for="upvotePoints" class="col-sm-3 col-form-label">Points per 👍</label>
						<div class="col-sm-9">
							<input type="number" class="form-control" name="upvotePoints" id="upvotePoints" value="<%- game.audienceScoring?.upvotePoints ?? 1 %>" min="0" required>
						</div>
					</div>
				</div>
				<div class="col">
					<div class="row">
						<label for="roflPoints" class="col-sm-3 col-form-label">Points per 🤣</label>
						<div class="col-sm-9">
							<input type="number" class="form-control" name="roflPoints" id="roflPoints" value="<%- game.audienceScoring?.roflPoints ?? 1 %>" min="0" required>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="row">
		<label class="col-sm-2 col-form-label">Voting mode</label>
		<div class="col-sm-10 text-start">
			<div class="form-check form-check">
				<input class="form-check-input" type="radio" name="allowBoth" id="allowBothOption" value="true" <%- (game.audienceScoring?.allowBoth ?? true) ? "checked" : "" %>>
				<label class="form-check-label" for="allowBothOption">Two votes allowed per answer (👍 <strong>and</strong> 🤣)</label>
			</div>
			<div class="form-check form-check">
				<input class="form-check-input" type="radio" name="allowBoth" id="allowEitherOption" value="false" <%- (game.audienceScoring?.allowBoth ?? true) ? "" : "checked" %>>
				<label class="form-check-label" for="allowEitherOption">Only one vote allowed (👍 <strong>or</strong> 🤣)</label>
			</div>
		</div>
	</div>
	<div class="form-group row mt-2">
		<div class="col-sm-12">
			<input type="submit" class="form-control btn btn-primary" value="Save scoring settings">
		</div>
	</div>
</form>
